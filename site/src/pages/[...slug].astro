---
import { render, type CollectionEntry } from "astro:content";
import { Docs } from "@/components/docs";
import defaultMdxComponents from "fumadocs-ui/mdx";
import "@/styles/global.css";
import { getPageImageUrl, source } from "@/lib/source";
import Layout from "@/components/layout.astro";
import type { TOCItemType } from "fumadocs-core/toc";
import { Home } from "@/components/home";
import { SiteLink } from "@/components/site-link";

interface Props {
  page: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: { slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const slugs = typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const docsPage = source.getPage(slugs)!;
const imagePath = getPageImageUrl(docsPage);
const image = Astro.site ? new URL(imagePath, Astro.site).href : imagePath;

// The root `/` uses the server-rendered landing page. Other pages render
// the regular docs layout unchanged.
const isLanding = slugs.length === 0;

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: "#" + heading.slug,
}));
---

<Layout>
  {isLanding ? (
    <title>{"HooKit · Hook engine for Pi"}</title>
  ) : (
    <title>{page.data.title}</title>
  )}
  <meta name="title" content={page.data.title} />
  <meta name="description" content={page.data.description} />
  <meta property="og:image" content={image} />
  {isLanding ? (
    <Home />
  ) : (
    <Docs
      tree={source.getPageTree()}
      pathname={Astro.url.pathname}
      params={Astro.params}
      page={{ toc }}
      client:load
    >
      <h1 class="font-semibold text-3xl">{page.data.title}</h1>
      <p class="text-lg text-fd-muted-foreground mb-8">{page.data.description}</p>
      <div class="prose flex-1">
        <Content components={{ ...defaultMdxComponents, a: SiteLink }} />
      </div>
    </Docs>
  )}
</Layout>
